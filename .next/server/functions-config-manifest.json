        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?\\/api\\/form(?:\\/((?:[^\\/#\\?]+?)(?:\\/(?:[^\\/#\\?]+?))*))?(\\.json|\\.rsc|\\.segments\\/.+\\.segment\\.rsc)?[\\/#\\?]?$",
